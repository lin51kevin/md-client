  "main": "dist/index.js",
  "activationEvents": ["onWorkspaceReady"],
  "permissions": ["workspace", "file.read", "editor.read", "sidebar.panel", "statusbar.item", "contextmenu.item", "commands", "ui.message", "storage"],
  "engines": { "marklite": ">=0.11.0" }
}
